{
  "uid": "kubeamber",
  "title": "KubeAmber",
  "description": "What AI agents are changing in the cluster and what KubeAmber decided: decisions, risk, held changes waiting for a person, and the webhook's health.",
  "tags": [
    "kubeamber",
    "kubernetes",
    "ai-agents"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "schemaVersion": 41,
  "version": 1,
  "weekStart": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "KubeAmber docs",
      "type": "link",
      "icon": "doc",
      "targetBlank": true,
      "url": "https://kubeamber.github.io/kubeamber/integrations/#prometheus-and-grafana-alloy",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kubeamber_build_info, job)",
        "query": {
          "query": "label_values(kubeamber_build_info, job)",
          "refId": "job",
          "qryType": 1
        },
        "description": "The Prometheus job KubeAmber's metrics arrive under, one per installation.",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "skipUrlSync": false
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kubeamber_decisions_total{job=~\"$job\"}, gen_ai_agent_name)",
        "query": {
          "query": "label_values(kubeamber_decisions_total{job=~\"$job\"}, gen_ai_agent_name)",
          "refId": "agent",
          "qryType": 1
        },
        "description": "Filters the agent decision panels. Held changes and the webhook are shown for all agents.",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Waiting for a person",
      "description": "Held agent changes waiting for someone to approve or reject them now. List them with `kubeamber list`. Unanswered requests expire after `approvals.pendingTTL` (1 hour by default).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(max by (job) (kubeamber_change_requests{job=~\"$job\", kubeamber_phase=\"Pending\"}))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#E06C00",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Allowed",
      "description": "Agent changes KubeAmber let through in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum_over_time((clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"allow\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"allow\"} offset 1m), 0))[$__range:1m])",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Held",
      "description": "Agent changes held for a person in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum_over_time((clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"hold\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"hold\"} offset 1m), 0))[$__range:1m])",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Denied",
      "description": "Agent changes denied outright in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum_over_time((clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"deny\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"deny\"} offset 1m), 0))[$__range:1m])",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p99 review time",
      "description": "How long KubeAmber took to review agent changes. The API server waits `webhook.timeoutSeconds` (5 by default) and then refuses the change.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(kubeamber_review_duration_seconds_bucket{job=~\"$job\"}[$__range]))) >= 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "noValue": "No reviews",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#E06C00",
                "value": 1
              },
              {
                "color": "#E02F44",
                "value": 2.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Median decision wait",
      "description": "Median time from a change being held to someone approving or rejecting it, in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(kubeamber_approval_wait_seconds_bucket{job=~\"$job\"}[$__range]))) >= 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "noValue": "No decisions",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Agent decisions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Decisions by outcome",
      "description": "Agent changes per interval, by what KubeAmber decided. An approved retry is the agent's retry of a change someone approved; a rejected retry is one refused because someone rejected it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 11,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"allow\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"allow\"} offset $__interval), 0)",
          "legendFormat": "Allowed",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"approved\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"approved\"} offset $__interval), 0)",
          "legendFormat": "Approved retry",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"hold\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"hold\"} offset $__interval), 0)",
          "legendFormat": "Held",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"rejected\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"rejected\"} offset $__interval), 0)",
          "legendFormat": "Rejected retry",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "clamp_min(sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"deny\"}) - sum (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=\"deny\"} offset $__interval), 0)",
          "legendFormat": "Denied",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisPlacement": "auto",
            "axisLabel": "",
            "gradientMode": "none",
            "spanNulls": false,
            "insertNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Allowed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56A64B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Approved retry"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Held"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E06C00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rejected retry"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A352CC"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Denied"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E02F44"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Risk scores",
      "description": "How many agent changes scored in each band of 10, in the selected time range. By default a score of 30 or more is held and 80 or more is denied (`spec.thresholds`).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 11,
        "y": 5,
        "w": 5,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (le) (increase(kubeamber_risk_score_bucket{job=~\"$job\", gen_ai_agent_name=~\"$agent\", le!=\"+Inf\"}[$__range]))",
          "legendFormat": "{{le}}",
          "range": false,
          "instant": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3274D9"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^10(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "0–10"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^20(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "11–20"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^30(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "21–30"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^40(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "31–40"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^50(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "41–50"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^60(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "51–60"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^70(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "61–70"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^80(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "71–80"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^90(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "81–90"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^100(\\.0)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "91–100"
              }
            ]
          }
        ]
      },
