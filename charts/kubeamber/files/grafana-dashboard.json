    {
      "id": 10,
      "type": "table",
      "title": "Decisions by agent",
      "description": "How many of each agent's changes were allowed, held and denied in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum_over_time((clamp_min(sum by (gen_ai_agent_name, kubeamber_outcome) (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=~\"allow|hold|deny\"}) - sum by (gen_ai_agent_name, kubeamber_outcome) (kubeamber_decisions_total{job=~\"$job\", gen_ai_agent_name=~\"$agent\", kubeamber_outcome=~\"allow|hold|deny\"} offset 1m), 0))[$__range:1m]) > 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "kubeamber_outcome",
            "rowField": "gen_ai_agent_name",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "gen_ai_agent_name\\kubeamber_outcome": "Agent",
              "allow": "Allowed",
              "hold": "Held",
              "deny": "Denied"
            },
            "indexByName": {
              "gen_ai_agent_name\\kubeamber_outcome": 0,
              "allow": 1,
              "hold": 2,
              "deny": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "width": 100,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Agent"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Held",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Held changes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Held changes waiting",
      "description": "Held changes waiting for a decision, and approved ones the agent has not retried yet. An approval is usable for `approvals.ttl` (15 minutes by default). Not filtered by agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(max by (job) (kubeamber_change_requests{job=~\"$job\", kubeamber_phase=\"Pending\"}))",
          "legendFormat": "Waiting for a person",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum(max by (job) (kubeamber_change_requests{job=~\"$job\", kubeamber_phase=\"Approved\"}))",
          "legendFormat": "Approved, not yet applied",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Waiting for a person"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E06C00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Approved, not yet applied"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Decisions on held changes",
      "description": "Approvals and rejections in the selected time range, where they were made (in the cluster with `kubeamber approve` or `kubectl`, or in a change-management system such as ServiceNow), and how long the change waited. Not filtered by agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (kubeamber_decision_source, kubeamber_decision) (increase(kubeamber_approval_wait_seconds_count{job=~\"$job\"}[$__range])) > 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (kubeamber_decision_source, kubeamber_decision, le) (increase(kubeamber_approval_wait_seconds_bucket{job=~\"$job\"}[$__range]))) >= 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.9, sum by (kubeamber_decision_source, kubeamber_decision, le) (increase(kubeamber_approval_wait_seconds_bucket{job=~\"$job\"}[$__range]))) >= 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "kubeamber_decision_source": "Where",
              "kubeamber_decision": "Decision",
              "Value #A": "Decisions",
              "Value #B": "Median wait",
              "Value #C": "90th percentile wait"
            },
            "indexByName": {
              "kubeamber_decision_source": 0,
              "kubeamber_decision": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Decisions"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*wait"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Decisions",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Webhook",
