    {
      "id": 15,
      "type": "timeseries",
      "title": "Review time",
      "description": "How long KubeAmber takes to review an agent change. Holds take longest, because they create a ChangeRequest. The API server waits `webhook.timeoutSeconds` (5 by default) and then refuses the change.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kubeamber_review_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "Median",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
