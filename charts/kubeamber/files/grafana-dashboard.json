          "legendFormat": "90th percentile",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kubeamber_review_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
