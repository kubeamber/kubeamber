# Image for local kind runs: packages a binary compiled on the host
# (make docker-build-local), so nothing is downloaded or compiled inside
# Docker. Releases use the multi-stage Dockerfile at the repository root.
FROM gcr.io/distroless/static:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087
COPY bin/linux/kubeamber /kubeamber
USER 65532:65532
ENTRYPOINT ["/kubeamber"]
